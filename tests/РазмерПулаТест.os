// Заготовка autumn-data: размер пула соединений менеджера берется из настроек источника данных.
//
// У пула entity нет геттера размера, поэтому размер проверяется по поведению: пул размера 0
// не держит соединений после операции, пул по умолчанию оставляет соединение инициализации.
//
// BSLLS:MagicNumber-off

#Использовать ".."
#Использовать "."
#Использовать autumn

&Пластилин
Перем Поделка;

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСОднимКоннекторомКакСоответствие()")
Процедура КогдаРазмерПулаНеЗадан_ТогдаПулДержитСоединениеПослеИнициализации() Экспорт

	// Дано-Когда
	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");

	// Тогда
	Пул = МенеджерСущностей.ПолучитьПулСоединений();
	Ожидаем.Что(Пул.КоличествоСозданных()).Равно(1);
	Ожидаем.Что(Пул.КоличествоСвободных()).Равно(1);

КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСНулевымПулом()")
Процедура КогдаРазмерПулаНоль_ТогдаСоединенияНеПереиспользуются() Экспорт

	// Дано-Когда
	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");

	// Тогда - размер из настроек дошел до менеджера: соединение инициализации закрыто, а не возвращено в пул
	Пул = МенеджерСущностей.ПолучитьПулСоединений();
	Ожидаем.Что(Пул.КоличествоСозданных()).Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных()).Равно(0);

КонецПроцедуры
