// Заготовка autumn-data: размер пула из настроек источника и регистрация наблюдателей сущностей
// по прозвищу НаблюдательСущностей во всех менеджерах.
//
// BSLLS:MagicNumber-off

#Использовать ".."
#Использовать "."
#Использовать autumn

&Пластилин
Перем Поделка;

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСОднимКоннекторомКакСоответствие()")
Процедура КогдаРазмерПулаНеЗадан_ТогдаИсточникИМенеджерПолучаютРазмерПоУмолчанию() Экспорт

	// Дано-Когда
	ИсточникДанных = Поделка.НайтиЖелудь("ИсточникДанных");
	Наблюдатель = Поделка.НайтиЖелудь("НаблюдательЗаписывающийЖелудь");
	Поделка.НайтиЖелудь("МенеджерСущностей");

	// Тогда
	Ожидаем.Что(ИсточникДанных.РазмерПула()).Равно(10);
	Захваты = Наблюдатель.Завершенные("Соединение", "Занять");
	Ожидаем.Что(Захваты.Количество() > 0, "Инициализация менеджера занимала соединение").ЭтоИстина();
	Ожидаем.Что(Захваты[0].Предел()).Равно(10);

КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСРазмеромПула()")
Процедура КогдаРазмерПулаЗадан_ТогдаПулМенеджераТакогоРазмера() Экспорт

	// Дано-Когда
	ИсточникДанных = Поделка.НайтиЖелудь("ИсточникДанных");
	Наблюдатель = Поделка.НайтиЖелудь("НаблюдательЗаписывающийЖелудь");
	Поделка.НайтиЖелудь("МенеджерСущностей");

	// Тогда
	Ожидаем.Что(ИсточникДанных.РазмерПула()).Равно(3);
	Захваты = Наблюдатель.Завершенные("Соединение", "Занять");
	Ожидаем.Что(Захваты[0].Предел()).Равно(3);

КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСОднимКоннекторомКакСоответствие()")
Процедура КогдаЕстьЖелудьСПрозвищемНаблюдательСущностей_ТогдаОнВидитСобытияМенеджераСИнициализации() Экспорт

	// Дано
	Наблюдатель = Поделка.НайтиЖелудь("НаблюдательЗаписывающийЖелудь");
	Ожидаем.Что(Наблюдатель.События, "До создания менеджера событий нет").ИмеетДлину(0);

	// Когда
	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");
	ФизическоеЛицо = МенеджерСущностей.СоздатьЭлемент(Тип("ФизическоеЛицо"));
	ФизическоеЛицо.Идентификатор = 1;
	МенеджерСущностей.Сохранить(ФизическоеЛицо);

	// Тогда
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Инициализировать"), "Наблюдатель зарегистрирован до инициализации").ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Сохранить")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Сохранить")[0].ТипСущности()).Равно(Тип("ФизическоеЛицо"));

КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСДвумяКоннекторамиКакМассив()")
Процедура КогдаИсточниковНесколько_ТогдаНаблюдательПолучаетСобытияКаждогоМенеджера() Экспорт

	// Дано
	Наблюдатель = Поделка.НайтиЖелудь("НаблюдательЗаписывающийЖелудь");

	// Когда
	Поделка.НайтиЖелуди("МенеджерСущностей", , "Соответствие");

	// Тогда
	Инициализации = Наблюдатель.Завершенные("Операция", "Инициализировать");
	Ожидаем.Что(Инициализации).ИмеетДлину(2);

	Системы = Новый Массив;
	Для Каждого Инициализация Из Инициализации Цикл
		Системы.Добавить(Инициализация.Система());
	КонецЦикла;
	Ожидаем.Что(Системы).Содержит("inmemory");
	Ожидаем.Что(Системы).Содержит("sqlite");

КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> ГенераторДанных.СоветДругогоМастераСОднимКоннекторомКакСоответствие()")
Процедура КогдаЗавязьНаблюдателяВернулаНеопределено_ТогдаОнаПропускается() Экспорт

	// Дано - в контексте есть ДубПустогоНаблюдателя, чья завязь с прозвищем отдает Неопределено

	// Когда
	МенеджерСущностей = Поделка.НайтиЖелудь("МенеджерСущностей");

	// Тогда - менеджер создан, настоящий наблюдатель работает
	Ожидаем.Что(МенеджерСущностей).ИмеетТип("МенеджерСущностей");
	Наблюдатель = Поделка.НайтиЖелудь("НаблюдательЗаписывающийЖелудь");
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Инициализировать")).ИмеетДлину(1);

КонецПроцедуры
